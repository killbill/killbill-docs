# Cloudflare Pages custom headers, served from the site root.
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
# Cloudflare Pages accepts at most 100 rules in this file.

# The production *.pages.dev alias and the branch/commit preview hosts serve copies of
# docs.killbill.io. Keep them out of search indexes.
https://docs-killbill-io.pages.dev/*
  X-Robots-Tag: noindex

https://:sub.docs-killbill-io.pages.dev/*
  X-Robots-Tag: noindex

# Not a documentation page. It now returns the 404 page.
/errors/*
  X-Robots-Tag: noindex
